# HTTPS in front of the web app. Caddy gets and renews the Let's Encrypt certificate by itself
# once ORDARO_DOMAIN points at this server and ports 80 and 443 are open.
# The API is never exposed: the browser only ever talks to the web app.

{$ORDARO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:3000
}
