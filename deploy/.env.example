# deploy/.env on the server. Never commit the real one (it is git-ignored).
# bootstrap-database.sh fills in the two role passwords for you.

# The address people type. With no domain yet, use the server's Elastic IP with dashes and
# .sslip.io — for 13.229.10.20 that is 13-229-10-20.sslip.io — and HTTPS still works.
TRILLOPOS_DOMAIN=13-229-10-20.sslip.io

# RDS. Keep sslmode=require: RDS refuses unencrypted connections anyway.
TRILLOPOS_DB_URL=jdbc:postgresql://trillopos.xxxxxxxx.ap-southeast-1.rds.amazonaws.com:5432/trillopos?sslmode=require
TRILLOPOS_OWNER_USER=trillopos_owner
TRILLOPOS_OWNER_PASSWORD=
TRILLOPOS_APP_USER=trillopos_app
TRILLOPOS_APP_PASSWORD=

# Only people you give this word to can create a shop on this server (your sister, her staff).
TRILLOPOS_SIGNUP_CODE=choose-a-word
