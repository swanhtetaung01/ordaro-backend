# Copy to .env (git-ignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=<local-postgres-password>
ORDARO_OWNER_PASSWORD=<owner-role-password>
ORDARO_APP_PASSWORD=<app-role-password>

# Read by the application (see src/main/resources/application.properties)
ORDARO_DB_URL=jdbc:postgresql://localhost:5432/ordaro
ORDARO_OWNER_USER=ordaro_owner
ORDARO_APP_USER=ordaro_app
# A JWK set of EC P-256 private keys; blank = ephemeral key (tokens die on restart)
ORDARO_JWT_KEYS_FILE=
