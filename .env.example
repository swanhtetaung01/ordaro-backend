# Copy to .env (git-ignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=<local-postgres-password>
TRILLOPOS_OWNER_PASSWORD=<owner-role-password>
TRILLOPOS_APP_PASSWORD=<app-role-password>

# Read by the application (see src/main/resources/application.properties)
TRILLOPOS_DB_URL=jdbc:postgresql://localhost:5432/trillopos
TRILLOPOS_OWNER_USER=trillopos_owner
TRILLOPOS_APP_USER=trillopos_app
# A JWK set of EC P-256 private keys; blank = ephemeral key (tokens die on restart)
TRILLOPOS_JWT_KEYS_FILE=
# Serve /v3/api-docs (for generating the web client). Never true in production.
TRILLOPOS_OPENAPI=true
